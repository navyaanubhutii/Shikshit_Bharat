# Application Configuration
APP_NAME="Shikshit Bharat API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
# For production PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shikshit_bharat
# For local fallback development:
# DATABASE_URL=sqlite:///./shikshit_bharat.db

# CORS Configuration (comma-separated allowed origins or * for open dev)
ALLOWED_ORIGINS=*
